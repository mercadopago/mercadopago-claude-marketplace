{
  "permissions": {
    "allow": [
      "Read(plugins/**)",
      "Read(CLAUDE.md)",
      "Read(CONTRIBUTING.md)",
      "Read(README.md)",
      "Read(.claude-plugin/**)",
      "Read(.github/**)",
      "Bash(python3 -m json.tool *)",
      "Bash(python3 -m py_compile *)",
      "Bash(find plugins/mercadopago/skills *)",
      "Bash(wc -l *)",
      "Bash(grep -l *)",
      "Bash(head *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(.envrc)",
      "Read(*.env)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)"
    ]
  },
  "enableAllProjectMcpServers": false
}
